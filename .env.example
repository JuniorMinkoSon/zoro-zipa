# Mail Configuration (Gmail SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Spring Configuration
SERVER_PORT=8080
# Use PostgreSQL / Neon by setting DATABASE_URL, DB_USERNAME and DB_PASSWORD.
# Example:
# DATABASE_URL=jdbc:postgresql://your-neon-host:5432/your_database
# DB_USERNAME=your_neon_user
# DB_PASSWORD=your_neon_password

# Fallback H2 local database (only use if you do not want Neon)
# SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/zoro-zipa;MODE=LEGACY

# File Storage
APP_FILE_STORAGE_UPLOAD_DIR=/app/uploads

# Frontend API URL (for building frontend)
VITE_API_URL=http://localhost:8080/api

# Admin access. The account is created ONLY on an empty database, at first start.
# Never write a usable password here: this file is committed, and the repository
# can be read. Put the real value in the hosting provider's environment variables.
# Careful: changing this value later does NOT change the password of an account
# that already exists — use the Profile screen of the admin panel for that.
ADMIN_EMAIL=admin@zorozipa.com
ADMIN_PASSWORD=

# Visitor entry screen (name + phone). Cross-domain deployments (frontend on
# Vercel, API elsewhere) need SameSite=None and Secure, otherwise the browser
# drops the session cookie and the screen reappears on every visit.
# VISITOR_COOKIE_SAME_SITE=None
# VISITOR_COOKIE_SECURE=true
# VISITOR_COOKIE_MAX_AGE_DAYS=180

# Optional client account, created on first start only if BOTH values are set.
# Leave them out and no client account is created. Never commit a real password here.
APP_USER_EMAIL=
APP_USER_PASSWORD=
